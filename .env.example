# Kopyalayın: cp .env.example .env  ve CHANGE_ME olanları doldurun.
# Güçlü değer üretmek için: openssl rand -hex 16

# Tarayıcıdan erişilen tam adres (CSRF koruması bununla çalışır; nginx'teki adresle aynı olmalı)
APP_ORIGIN=https://naman.xenny.cloud

POSTGRES_USER=naman
POSTGRES_DB=naman
POSTGRES_PASSWORD=CHANGE_ME

# İlk açılışta hiç kullanıcı yoksa bu yönetici hesabı oluşturulur (sonra ADMIN_PASSWORD satırını silin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_EN_AZ_10_KARAKTER

# namtag 3000/4000 portlarını kullandığı için varsayılanlar farklıdır
# WEB_PORT=3100
# API_PORT=4100
# SESSION_IDLE_HOURS=12
# SESSION_MAX_DAYS=7
